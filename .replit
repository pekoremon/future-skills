modules = ["python-3.11"]
# Replit's Python forces pip --user installs, which fail where user site-packages are
# disabled. Install into a project venv with --no-user instead.
run = "python -m venv .venv && .venv/bin/pip install -q --no-user -r requirements.txt && .venv/bin/python src/main.py"
entrypoint = "src/main.py"

[nix]
channel = "stable-24_05"

[deployment]
build = [
  "sh",
  "-c",
  "python -m venv .venv && .venv/bin/pip install --no-user -r requirements.txt",
]
run = ["sh", "-c", ".venv/bin/python src/main.py"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8080
externalPort = 80
