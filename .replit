modules = ["python-3.12", "nodejs-20", "web"]
run = "PORT=5000 python src/main.py"
entrypoint = "src/main.py"

[nix]
channel = "stable-25_05"

# The app uses only the Python standard library, so there is nothing to install.
# (Replit's automatic "pip install -r requirements.txt" step failed with "--user"
# errors on publish; with no requirements.txt it has nothing to run.)
[packager.features]
enabledForHosting = false

[deployment]
run = ["python", "src/main.py"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 python src/main.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
