modules = ["python-3.12", "nodejs-20", "web"]
run = "PORT=5000 python src/main.py"
entrypoint = "src/main.py"

[nix]
channel = "stable-25_05"

# Replit's automatic package install runs before the build and fails with "Can not
# perform a '--user' install". Skip it; the build below installs into a project venv.
[packager.features]
enabledForHosting = false

[deployment]
build = ["sh", "-c", "unset PIP_TARGET PIP_USER; python -m venv .venv && .venv/bin/pip install --no-user -r requirements.txt"]
run = ["sh", "-c", ".venv/bin/python src/main.py"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 python src/main.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

[userenv.production]

[userenv.shared]
PIP_TARGET = ".pythonlibs/lib/python3.12/site-packages"
PIP_USER = "false"
