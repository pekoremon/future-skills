# Copy this file to .env (local) or add these to Replit Secrets.
# Never commit your real .env file.
PROJECT_NAME="Future Skills"

# Optional: enables the "Explain this for me" button (Fireworks AI). Without it the
# button shows a plain summary written from the scores instead.
FIREWORKS_API_KEY=
# Optional: any Fireworks chat model id; default accounts/fireworks/models/gpt-oss-120b
FIREWORKS_MODEL=
