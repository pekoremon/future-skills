# Copy this file to .env (local) or add these to Replit Secrets.
# Never commit your real .env file.
PROJECT_NAME="Future Skills"

# Optional: enables the AI CV summary and the "Explain this for me" button. Without it
# the app shows a plain summary written from the scores instead.
# Any OpenAI-compatible API works. For the KrackedDevs keys:
#   LLM_BASE_URL=https://litellm.rapidscreen.io/v1  and a model id that key can use.
# Leave LLM_BASE_URL empty for Fireworks AI (default model accounts/fireworks/models/gpt-oss-120b).
# FIREWORKS_API_KEY / FIREWORKS_MODEL still work when the LLM_ names are not set.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
